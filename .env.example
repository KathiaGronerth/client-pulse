# Anthropic API key — enables the LLM-generated call-prep brief.
# Without it, the app falls back to the deterministic rule-based brief.
# Get a key at https://console.anthropic.com/ and copy this file to .env.local:
#   cp .env.example .env.local
# Never commit .env.local (it is gitignored).
ANTHROPIC_API_KEY=
